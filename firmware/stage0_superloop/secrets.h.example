// Copy this file to secrets.h (same folder) and fill it in.
// secrets.h is ignored by git; this example is the only version committed.

#pragma once

// 2.4 GHz only. A phone hotspot must be set to 2.4 GHz or the board never joins.
#define WIFI_SSID "YOUR_WIFI_NAME"
#define WIFI_PASS "YOUR_WIFI_PASSWORD"

// The faculty broker. To work offline, run the local broker from
// iot-dashboard/compose.local-broker.yml and put your computer's IP address here.
#define MQTT_HOST "control.aut.utcluj.ro"
#define MQTT_PORT 11188
